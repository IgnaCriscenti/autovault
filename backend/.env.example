PORT=3000
NODE_ENV=development

# URI de MongoDB Atlas, incluyendo el nombre de la base (ej: .../autovault?retryWrites=true)
# Tiene usuario y contraseña: NUNCA commitearla.
MONGODB_URI=
# Opcional (solo local): si falla con "querySrv ECONNREFUSED", forzar DNS publicos
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Secreto para firmar las sesiones. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publica del FRONT (las requests a /api llegan por el proxy). Local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# OAuth App de GitHub (una para local y otra para produccion)
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Client de Google (tipo "Aplicacion web", sirve para local y produccion)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
